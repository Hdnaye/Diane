{
  // pb_hooks/ and pb_migrations/ run inside PocketBase's embedded JS engine
  // (goja), not in Node: no Node types, only the globals declared in
  // pb_data/types.d.ts (generated by PocketBase, see `npm run setup`).
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "types": [],
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["pb_hooks", "pb_migrations", "pb_data/types.d.ts"]
}
