# Copy to backend/.env (never committed) and replace the fake values, then
# run `npm run setup` to create or update the organizer account.
# `npm run dev` passes these variables to PocketBase (the environment wins).

# E-mail of the single organizer account (its login identity).
DIANE_ORGANIZER_EMAIL=organizer@example.com

# Secret key the app authenticates with silently (the account password):
# long and random, at least 32 characters, e.g. `openssl rand -hex 32`.
# Put the same value in the app's .env.
DIANE_ORGANIZER_KEY=replace-me-with-the-output-of-openssl-rand-hex-32

# Public base URL of the members' answer page (the app's web export served
# by PocketBase). Answer links are {DIANE_PUBLIC_URL}/r/{token}. Keep it
# short: it is part of every invitation SMS. Required to send invitations.
DIANE_PUBLIC_URL=https://diane.example.org

# SMS Gateway for Android (https://github.com/capcom6/android-sms-gateway):
# base URL of its API, without trailing slash, and the basic auth
# credentials shown by the app.
# - local server (phone on the same network): http://<phone-ip>:8080
# - cloud relay: https://api.sms-gate.app/3rdparty/v1
# Unset: invitations are still created, their SMS recorded as failed.
DIANE_SMS_GATEWAY_URL=http://192.168.1.50:8080
DIANE_SMS_GATEWAY_USERNAME=sms
DIANE_SMS_GATEWAY_PASSWORD=replace-me-with-the-gateway-password

# Sender of the invitation e-mails. SMTP itself is configured in the
# PocketBase admin UI (Settings > Mail settings); disabled: e-mails are
# recorded as failed. Empty sender: the admin UI's sender.
DIANE_EMAIL_SENDER_ADDRESS=diane@example.org
DIANE_EMAIL_SENDER_NAME=Diane

# Tests only: record messages as files instead of sending them.
# DIANE_SMS_TRANSPORT=fake
# DIANE_EMAIL_TRANSPORT=fake
# DIANE_FAKE_OUTBOX_DIR=/tmp/diane-outbox
