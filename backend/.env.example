# Copy to backend/.env (never committed) and replace the fake values, then
# run `npm run setup` to create or update the organizer account.

# E-mail of the single organizer account (its login identity).
DIANE_ORGANIZER_EMAIL=organizer@example.com

# Secret key the app authenticates with silently (the account password):
# long and random, at least 32 characters, e.g. `openssl rand -hex 32`.
# Put the same value in the app's .env.
DIANE_ORGANIZER_KEY=replace-me-with-the-output-of-openssl-rand-hex-32
