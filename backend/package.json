{
  "name": "diane-backend",
  "version": "0.0.0",
  "private": true,
  "description": "Diane back-end: PocketBase hooks, migrations and pure business logic",
  "type": "module",
  "packageManager": "npm@10.9.9",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "setup": "node scripts/setup-pocketbase.js",
    "dev": "node scripts/dev.js",
    "typegen": "node scripts/typegen.js",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.pocketbase.json",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/jsdom": "30.0.0",
    "@types/node": "22.20.5",
    "@vitest/eslint-plugin": "1.6.28",
    "eslint": "10.14.0",
    "fflate": "0.8.3",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "pocketbase-typegen": "1.5.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12"
  }
}
