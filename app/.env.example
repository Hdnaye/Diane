# Copy to app/.env (never committed) and replace the fake values with those of backend/.env.
# Expo embeds EXPO_PUBLIC_* variables in the app and in the web export: the organizer key is
# embedded in the demo app (accepted for the POC, see CLAUDE.md, "Accès organisateur").
# Restart `npm start` after changing them.

# PocketBase address, reachable from the phone (same network): not 127.0.0.1 in Expo Go,
# the computer's IP address, e.g. http://192.168.1.20:8090.
EXPO_PUBLIC_DIANE_API_URL=http://192.168.1.20:8090

# Same values as DIANE_ORGANIZER_EMAIL and DIANE_ORGANIZER_KEY in backend/.env.
EXPO_PUBLIC_DIANE_ORGANIZER_EMAIL=organizer@example.com
EXPO_PUBLIC_DIANE_ORGANIZER_KEY=replace-me-with-the-key-of-backend-env
